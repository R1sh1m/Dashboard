# ESP32 LoRa Receiver - sdkconfig.defaults
# Team Artemis Ground Station Dashboard

CONFIG_IDF_TARGET_ESP32=y

# Console output via UART (COMx)
CONFIG_ESP_CONSOLE_UART=y
CONFIG_ESP_CONSOLE_UART_NONE=n
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# USB CDC (for JSON output to dashboard)
CONFIG_USB_CDC_ENABLED=y
CONFIG_USB_CDC_BAUDRATE=115200

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# SPI
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y
