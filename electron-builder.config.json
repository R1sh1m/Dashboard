{
  "appId": "com.artemis.groundstation",
  "productName": "Artemis Ground Station",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**",
    "electron/dist/**"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${productName} Setup ${version}.${ext}"
  },
  "publish": null
}
