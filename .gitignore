# ==============================================================================
# Team Artemis Ground Station Dashboard - Git Ignore Rules
# ==============================================================================

# Node.js & Web Dependencies
node_modules/
.npm/

# Web & Project Build Outputs
dist/
dist-ssr/
build/
.vite/
*.local

# Test & E2E Run Artifacts (keep tests/ directory tracked!)
test-results/
playwright-report/
blob-report/

# Embedded C / C++ Compiler & Linker Outputs
*.o
*.obj
*.d
*.su
*.elf
*.bin
*.hex
*.map
subdir.mk
makefile.init

# ESP-IDF Build Artifacts & Configuration Backups
esp_receiver/build/
esp_receiver/sdkconfig.old

# STM32 Build & IDE Artifacts
Sender_station/**/bin/
Sender_station/**/Debug/
Sender_station/**/Release/
Sender_station/**/.settings/

# Python Cache & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Clangd & Tooling Intermediate Files
.clangd
**/.clangd
.clangd/
**/.clangd/
compile_commands.json
**/compile_commands.json

# Internal Agent Frameworks, Skills & Configs (Internal Use Only)
AGENTS.md
*AGENTS*.md
.agents/
.agents*/
.opencode/
.opencode*/
opencode.json
opencode.jsonc
.context/
context/
.github/instructions/

# IDEs & Editor Configuration (Internal Settings)
.vscode/
.vscode/*
settings.json
**/settings.json
.idea/
*.swp
*.swo
*~
*.code-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp

# Personal / Developer Scratch Files
gdb_cmd*.txt
*.diff
sx126*.diff
*DESIGN.md
design*.md

# Project Config Files (local/personal)
package.json
package-lock.json
tsconfig.json
tsconfig.*.json
vite.config.*
vitest.config.*
playwright.config.*
esp_receiver/sdkconfig
esp_receiver/sdkconfig.defaults
