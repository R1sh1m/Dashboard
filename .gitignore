.vscode/
.vscode/*
settings.json
**/settings.json
.idea/
*.swp
*.swo
*~
*.code-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp

